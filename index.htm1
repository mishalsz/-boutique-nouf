<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Boutique Nouf | بوتيك نوف</title>

<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600&family=IBM+Plex+Sans+Arabic:wght@400;600;700&display=swap" rel="stylesheet">

<style>
:root {
--pink:#f7e5e9;
--rose:#c98291;
--ink:#30252a;
--cream:#fffafb;
}

* {box-sizing:border-box}

body {
margin:0;
background:var(--cream);
color:var(--ink);
font-family:'IBM Plex Sans Arabic',sans-serif;
}

header {
padding:22px 6%;
display:flex;
justify-content:space-between;
align-items:center;
background:white;
border-bottom:1px solid #f0e2e6;
}

.logo {
font:600 27px 'Playfair Display',serif;
color:#9d6472;
direction:ltr;
}

.logo small {
display:block;
text-align:center;
font:500 12px 'IBM Plex Sans Arabic';
}

nav {
display:flex;
gap:15px;
align-items:center;
}

nav a {
color:var(--ink);
text-decoration:none;
}

.cart {
background:var(--ink);
color:white;
border:0;
border-radius:25px;
padding:12px 18px;
cursor:pointer;
}

.hero {
padding:65px 7%;
text-align:center;
background:linear-gradient(135deg,#fff,#f8e9ed);
}

.hero h1 {
font:600 clamp(38px,7vw,65px) 'Playfair Display',serif;
direction:ltr;
}

.hero p {
color:#806f75;
}

.cta {
display:inline-block;
background:var(--rose);
color:white;
padding:12px 28px;
border-radius:30px;
text-decoration:none;
}

.wrap {
max-width:1100px;
margin:auto;
padding:40px 6%;
}

.section-head {
display:flex;
justify-content:space-between;
align-items:center;
margin-bottom:20px;
}

.section-head h2 {
font:600 29px 'Playfair Display',serif;
direction:ltr;
}

.section-head p {
font-size:13px;
color:#806f75;
}

.grid {
display:grid;
grid-template-columns:repeat(3,1fr);
gap:18px;
}

.card {
background:white;
border:1px solid #f0e2e6;
border-radius:17px;
overflow:hidden;
}

.card img {
width:100%;
height:230px;
object-fit:cover;
}

.card-body {
padding:15px;
}

.row {
display:flex;
justify-content:space-between;
align-items:center;
}

.price {
font-weight:bold;
color:#a96678;
}

.add {
width:100%;
margin-top:12px;
padding:11px;
border:1px solid var(--rose);
color:#995f70;
background:#fff7f9;
border-radius:25px;
font-family:inherit;
cursor:pointer;
}

.add.selected {
background:var(--rose);
color:white;
}

footer {
text-align:center;
padding:30px;
color:#806f75;
}

@media(max-width:700px) {
.grid {grid-template-columns:repeat(2,1fr)}
.card img {height:170px}
}
</style>
</head>

<body>

<header>
<div class="logo">
Boutique Nouf
<small>بوتيك نوف</small>
</div>

<nav>
<a href="#section-a">Section A</a>
<a href="#section-b">Section B</a>
<button class="cart" onclick="goCheckout()">
السلة · <span id="count">0</span>
</button>
</nav>
</header>

<section class="hero">
<h1>Boutique Nouf</h1>
<p>تفاصيل صغيرة… ولمسة مختلفة.</p>
<a class="cta" href="#section-a">تسوقي المجموعة</a>
</section>

<main class="wrap">

<section id="section-a">
<div class="section-head">
<h2>Section A</h2>
<p>السعر الموحد — 89 ريال</p>
</div>
<div class="grid" id="gridA"></div>
</section>

<hr style="margin:40px 0;border:1px solid #f0e2e6">

<section id="section-b">
<div class="section-head">
<h2>Section B</h2>
<p>السعر الموحد — 89 ريال</p>
</div>
<div class="grid" id="gridB"></div>
</section>

</main>

<footer>
Boutique Nouf © 2026
</footer>

<script>

const products = [
...Array.from({length:6},(_,i)=>({
id:"A"+String(i+1).padStart(2,"0"),
section:"A"
})),
...Array.from({length:6},(_,i)=>({
id:"B"+String(i+1).padStart(2,"0"),
section:"B"
}))
];

let selected = JSON.parse(
localStorage.getItem("boutiquenouf_cart") || "[]"
);

function render(){

["A","B"].forEach(s=>{

document.getElementById("grid"+s).innerHTML =
products.filter(p=>p.section===s).map(p=>`

<article class="card">

<img src="nails-reference.jpeg"
alt="تصميم أظافر ${p.id}">

<div class="card-body">

<div class="row">
<strong>${p.id}</strong>
<span class="price">89 ر.س</span>
</div>

<p>أظافر تركيب — تصميم ${p.id}</p>

<button class="add ${selected.includes(p.id)?"selected":""}"
onclick="toggle('${p.id}')">

${selected.includes(p.id)?"تمت الإضافة ✓":"أضيفي إلى الطلب"}

</button>

</div>
</article>

`).join("");

});

document.getElementById("count").textContent =
selected.length;

}

function toggle(id){

selected = selected.includes(id)
? selected.filter(x=>x!==id)
: [...selected,id];

localStorage.setItem(
"boutiquenouf_cart",
JSON.stringify(selected)
);

render();

}

function goCheckout(){
location.href="checkout.html";
}

render();

</script>

</body>
</html>